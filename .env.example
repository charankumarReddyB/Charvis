# ==============================================================================
# CHARVIS (Charan's AI Virtual Intelligent System)
# Environment Configuration Template
# Copy this file to .env and fill in your custom values.
# ==============================================================================

# Application Settings
APP_NAME=CHARVIS
APP_VERSION=0.15.0
ENVIRONMENT=development

DEBUG=false

# Logging Settings (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/charvis.log

# AI Provider Configuration
# Supported providers: openai
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=1024
REQUEST_TIMEOUT=30.0

# API Keys (Never commit actual keys to source control)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional System Prompt Override (Leave empty to use default CHARVIS persona)
# SYSTEM_PROMPT=

# Filesystem Sandbox Settings (Phase 6)
FILESYSTEM_WORKSPACE=data/workspace
MAX_FILE_READ_BYTES=1048576
MAX_FILE_WRITE_BYTES=1048576
MAX_SEARCH_RESULTS=100
MAX_DIRECTORY_ENTRIES=200

# System Information & Control Settings (Phase 7)
SYSTEM_DRIVE=C:\

# Voice Input & Output Settings (Phase 8)
VOICE_ENABLED=true
STT_PROVIDER=google
TTS_PROVIDER=pyttsx3
STT_LANGUAGE=en-US
LISTEN_TIMEOUT=5.0
PHRASE_TIMEOUT=10.0
MAX_TTS_LENGTH=1000

# Wake Word Settings (Phase 9)
WAKE_WORD_PHRASE=hey charvis
WAKE_WORD_TIMEOUT=30.0
WAKE_WORD_FRAME_DURATION=1.0
COMMAND_LISTEN_TIMEOUT=5.0
WAKE_WORD_DETECTOR_TYPE=local

# Browser Automation Settings (Phase 10)
BROWSER_HEADLESS=false
BROWSER_NAVIGATION_TIMEOUT=30.0
BROWSER_ACTION_TIMEOUT=10.0
BROWSER_PAGE_TEXT_LIMIT=4000
BROWSER_USER_DATA_DIR=data/browser_profile

# Vision & OCR Settings (Phase 11)
OCR_PROVIDER_TYPE=tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MAX_SCREENSHOT_WIDTH=7680
MAX_SCREENSHOT_HEIGHT=4320
MAX_REGION_AREA=33177600
MAX_OCR_TEXT_LENGTH=4000
OCR_CONFIDENCE_THRESHOLD=0.0
SCREENSHOT_SAVE_DIR=data/workspace

# Vision & Screen Understanding Settings (Phase 12)
# Cloud vision is strictly disabled by default (false). Zero images leave computer unless explicitly enabled.
VISION_CLOUD_ENABLED=false
VISION_PROVIDER_TYPE=local
VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT=30.0
MAX_SCREEN_ELEMENTS=50
MAX_ELEMENT_LABEL_LENGTH=100
MAX_SCREEN_SUMMARY_LENGTH=1000

# Memory System Settings (Phase 13)
# Persistent local memory stored in SQLite; zero cloud syncing or vector DB.
MEMORY_ENABLED=true
MEMORY_DB_PATH=data/memory/charvis_memory.db
MAX_MEMORY_RESULTS=10
MAX_MEMORY_KEY_LENGTH=100
MAX_MEMORY_VALUE_LENGTH=2000
MAX_MEMORY_TAGS=10
DEFAULT_MEMORY_CONFIDENCE=0.9
MIN_RETRIEVAL_CONFIDENCE=0.3

# Task Planner Settings (Phase 14)
# Controlled sequential multi-step task execution; process-local in-memory tasks.
MAX_TASK_STEPS=15
MAX_REPLANS_PER_TASK=3
MAX_STEP_RETRIES=1
MAX_TASK_CONTEXT_LENGTH=4000
MAX_ACTIVE_TASKS=20

# Desktop GUI Settings (Phase 15)
GUI_WINDOW_TITLE=CHARVIS
GUI_WINDOW_WIDTH=1020
GUI_WINDOW_HEIGHT=720
GUI_THEME=dark
GUI_POLL_INTERVAL_MS=50

